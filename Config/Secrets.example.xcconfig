// Modelo de Config/Secrets.xcconfig — copie para esse nome e preencha.
// O arquivo real é ignorado pelo git: chave de API nunca vai para o repositório.
//
// Em xcconfig, "//" começa um comentário. Por isso a URL se escreve com $()
// entre as barras: https:/$()/servidor.exemplo.com

READONLY_API_BASE_URL = https:/$()/servidor.exemplo.com
READONLY_API_KEY = cole-a-chave-aqui
