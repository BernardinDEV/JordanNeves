// Configuração comum a TODOS os targets de aplicativo (uma marca = um target).
// O que muda por escritório fica em Brands/<Marca>/Brand.xcconfig, que inclui
// este arquivo e define as variáveis BRAND_*.
//
// Nada aqui pode citar um escritório. Se você precisou escrever um nome de
// marca neste arquivo, o lugar certo é o Brand.xcconfig da marca.

// ─────────── Identidade do módulo ───────────
// O binário e o ícone são da marca (PRODUCT_NAME = nome do target), mas o
// módulo Swift é sempre AdvClient. É isso que faz `@testable import AdvClient`
// valer para qualquer marca, sem duplicar a suíte de testes.
PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_MODULE_NAME = AdvClient

// ─────────── Vindo da marca ───────────
PRODUCT_BUNDLE_IDENTIFIER = $(BRAND_BUNDLE_ID)
INFOPLIST_FILE = $(BRAND_DIR)/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = $(BRAND_DISPLAY_NAME)

// ─────────── Plataforma ───────────
SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// ─────────── Versão e assinatura ───────────
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
CODE_SIGN_STYLE = Automatic
// A conta Apple é do escritório, não do produto: cada marca pode assinar
// na sua. Definido em Brands/<Marca>/Brand.xcconfig.
DEVELOPMENT_TEAM = $(BRAND_DEVELOPMENT_TEAM)

// ─────────── Assets ───────────
// Os nomes são fixos de propósito: o catálogo de cada marca precisa expor
// exatamente estes símbolos, e é o que o script de nova marca gera.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// ─────────── Info.plist gerado ───────────
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.business
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// ─────────── Localização ───────────
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

// ─────────── Fonte somente leitura (teste) ───────────
// Usada pela marca com "mode": "readonly" no Brand.json. Os valores reais ficam
// em Config/Secrets.xcconfig, que o git ignora — a chave nunca entra no código
// nem no repositório. Modelo: Config/Secrets.example.xcconfig.
READONLY_API_BASE_URL =
READONLY_API_KEY =
#include? "Secrets.xcconfig"
