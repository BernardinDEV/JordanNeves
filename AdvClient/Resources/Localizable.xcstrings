    "profile.deleteAccount.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account was created by the firm, so deletion happens by request. Documents and ongoing cases are retained for the period the law requires; everything else is erased."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta foi criada pelo escritório, então a exclusão é feita por solicitação. Documentos e processos em andamento são retidos pelo prazo que a lei exige; o restante é apagado."
          }
        }
      }
    },
