    "onb.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every case has dozens of movements. Almost none need your attention. The app separates the two."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo processo tem dezenas de movimentos. Quase nenhum precisa da sua atenção. O app separa os dois."
          }
        }
      }
    },
    "onb.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You see what needs you.\nThe rest stays in the background."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vê o que exige você.\nO resto fica em segundo plano."
          }
        }
      }
    },
    "onb.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No call centre, no ticket number. The button carries the case number with it — you just write the question."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem central de atendimento e sem “protocolo nº”. O botão já leva o número do processo junto — você só escreve a pergunta."
          }
        }
      }
    },
    "onb.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A question? One tap\nand you're on WhatsApp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dúvida? Um toque\ne você está no WhatsApp."
          }
        }
      }
    },
    "onb.3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The costliest liability is the one nobody saw coming. The app warns you before, not after."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O passivo mais caro é o que ninguém viu chegar. O app avisa antes, não depois."
          }
        }
      }
    },
    "onb.3.title": {
      "extractionState": "manual",
