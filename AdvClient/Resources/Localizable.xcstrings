    "case.underSeal.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This case is under judicial seal. No automated source publishes its movements — the firm's team updates it case by case."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este processo corre em segredo de justiça. Nenhuma fonte automática publica as movimentações — quem atualiza é a equipe do escritório, caso a caso."
          }
        }
      }
    },
    "case.underSeal.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movements are published by the team only."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimentações publicadas apenas pela equipe."
          }
        }
      }
    },
    "case.underSeal.timelineMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Because the case is under seal, movements don't arrive automatically. Talk to the responsible lawyer for the current status."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ser segredo de justiça, os andamentos não vêm automaticamente. Fale com o responsável para saber a situação atual."
          }
        }
      }
    },
